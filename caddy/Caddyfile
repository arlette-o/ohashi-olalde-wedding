arlettetakawedding.com {
	encode gzip

	# API traffic -> backend Express service
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Everything else -> static frontend (nginx)
	handle {
		reverse_proxy ui:80
	}
}

# www resolves to the same IP, so it needs its own block or it fails TLS.
www.arlettetakawedding.com {
	redir https://arlettetakawedding.com{uri} permanent
}
